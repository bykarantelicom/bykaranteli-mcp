{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.bykaranteli/mcp",
  "description": "Crypto derivatives data: funding, OI, liquidations, options, ETF flows. Free account key required.",
  "repository": {
    "url": "https://github.com/bykarantelicom/bykaranteli-mcp",
    "source": "github"
  },
  "version": "0.30.4",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "bykaranteli-mcp",
      "version": "0.30.4",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "websiteUrl": "https://bykaranteli.com/developers",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.bykaranteli.com/",
      "headers": [
        {
          "name": "x-api-key",
          "description": "Account key bk_... (free at https://bykaranteli.com/dashboard/api)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
